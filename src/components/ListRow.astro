---
interface Props {
  href?: string;
  title: string;
  /** Short marker rendered before the title in its own element (e.g. a Lab entry number). */
  index?: string;
  meta?: string;
  aside?: string;
  asideTone?: "ready" | "accent" | "muted";
  /** Language of the title when it differs from the page language (WCAG 3.1.2). */
  lang?: string;
  /** Language of the meta line when it differs from the page language. */
  metaLang?: string;
  metaMono?: boolean;
}
// Named slots `meta` and `aside` take markup (e.g. <DateTime slot="aside" />) in place of the
// string props of the same name.
const { href, title, index, meta, aside, asideTone = "muted", lang, metaLang, metaMono = false } = Astro.props;
const Tag = href ? "a" : "div";
const tone = { ready: "text-ready", accent: "text-accent", muted: "text-muted" }[asideTone];
---

<li class="border-line border-t">
  <Tag href={href} class:list={["flex items-baseline justify-between gap-3 py-3.5", href && "hover:text-accent"]}>
    <span class="flex min-w-0 flex-col gap-0.5">
      <span class="flex items-baseline gap-2">
        {index && <span class="font-mono text-accent text-xs">{index}</span>}
        <span class="font-medium" lang={lang}>{title}</span>
      </span>
      {(meta || Astro.slots.has("meta")) && <span class:list={["text-muted", metaMono ? "font-mono text-xs" : "text-sm"]} lang={metaLang}>{meta}<slot name="meta" /></span>}
    </span>
    {(aside || Astro.slots.has("aside")) && <span class:list={["shrink-0 font-mono text-xs", tone]}>{aside}<slot name="aside" /></span>}
  </Tag>
</li>
